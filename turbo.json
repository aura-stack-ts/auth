{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "!.turbo/**",
        ".next/**",
        "!.next/cache/**",
        ".tanstack/**",
        ".output/**",
        ".react-router/**",
        ".nuxt/**",
        ".astro/**",
        ".wrangler/**",
        ".vercel/output/**"
      ],
      "env": ["AURA_AUTH_*"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "format": {
      "dependsOn": ["^format"],
      "outputLogs": "new-only"
    },
    "//#format:root": {
      "outputLogs": "new-only"
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputLogs": "new-only",
      "persistent": false
    }
  },
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalEnv": [".env"],
  "concurrency": "100%",
  "remoteCache": {
    "enabled": true,
    "signature": false
  }
}
