generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// Prisma ORM 7: Configure the connection URL in prisma.config.ts.

/// ---------------------------------------------------------------------------
/// ENUMS
/// ---------------------------------------------------------------------------

enum UserStatus {
    active
    suspended
    pending_verification
    deleted
}

enum AccountType {
    oauth
    credentials
    magic_link
}

enum AccountStatus {
    active
    unlinked
    suspended
}

enum SessionStatus {
    active
    expired
    revoked
}

enum MFAState {
    none
    pending
    completed
    skipped
}

enum MFAMethod {
    totp
    webauthn_passkey
    webauthn_security_key
    sms
    email
    recovery_code
}

enum DeviceType {
    desktop
    mobile
    tablet
    tv
    bot
    unknown
}

enum MFAChallengeStatus {
    pending
    verified
    expired
    failed
}

enum MFACredentialStatus {
    active
    pending
    disabled
}

enum VerificationTokenType {
    email_verification
    password_reset
    email_change
    mfa_recovery
    email_change_cancel
    magic_link
}

/// ---------------------------------------------------------------------------
/// USERS
/// ---------------------------------------------------------------------------

model User {
    id              String     @id @default(cuid())
    name            String?
    email           String?    @unique
    image           String?
    emailVerifiedAt DateTime?
    status          UserStatus @default(active)
    attributes      Json?
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt
    deletedAt       DateTime?

    accounts           Account[]
    sessions           Session[]
    devices            Device[]
    mfaCredentials     MfaCredential[]
    verificationTokens VerificationToken[]
    mfaChallenges      MfaChallenge[]

    @@index([status])
    @@index([deletedAt])
}

/// ---------------------------------------------------------------------------
/// ACCOUNTS
/// ---------------------------------------------------------------------------

model Account {
    id             String        @id @default(cuid())
    userId         String
    provider       String
    providerUserId String
    type           AccountType
    status         AccountStatus @default(active)
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt
    deletedAt      DateTime?

    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    oauthAccount      OAuthAccount?
    credentialAccount CredentialAccount?

    @@unique([provider, providerUserId])
    @@index([userId])
    @@index([userId, status])
    @@index([deletedAt])
}

/// ---------------------------------------------------------------------------
/// OAUTH ACCOUNTS
/// ---------------------------------------------------------------------------

model OAuthAccount {
    accountId             String    @id
    accessToken           String
    refreshToken          String?
    idToken               String?
    tokenType             String?
    scopes                String?
    issuer                String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    updatedAt             DateTime  @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// ---------------------------------------------------------------------------
/// CREDENTIAL ACCOUNTS
/// ---------------------------------------------------------------------------

model CredentialAccount {
    accountId    String   @id
    passwordHash String
    updatedAt    DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

/// ---------------------------------------------------------------------------
/// DEVICES
/// ---------------------------------------------------------------------------

model Device {
    id          String     @id @default(cuid())
    userId      String
    name        String?
    type        DeviceType @default(unknown)
    platform    String?
    browser     String?
    userAgent   String?
    fingerprint String?
    lastIp      String?
    trusted     Boolean    @default(false)
    firstSeenAt DateTime   @default(now())
    lastSeenAt  DateTime   @default(now())
    deletedAt   DateTime?

    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    sessions          Session[]
    oauthTransactions OAuthTransaction[]

    @@index([userId])
    @@index([fingerprint])
    @@index([userId, trusted])
    @@index([deletedAt])
}

/// ---------------------------------------------------------------------------
/// SESSIONS
/// ---------------------------------------------------------------------------

model Session {
    id                String        @id @default(cuid())
    userId            String
    deviceId          String?
    authenticatedWith String
    status            SessionStatus @default(active)
    mfaState          MFAState      @default(none)
    tokenHash         String        @unique
    expiresAt         DateTime
    lastActivityAt    DateTime      @default(now())
    revokedAt         DateTime?
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
    mfaChallenges MfaChallenge[]

    @@index([userId])
    @@index([userId, status])
    @@index([deviceId])
    @@index([expiresAt])
    @@index([status, expiresAt])
    @@index([revokedAt])
}

/// ---------------------------------------------------------------------------
/// MFA CREDENTIALS
/// ---------------------------------------------------------------------------

model MfaCredential {
    id         String              @id @default(cuid())
    userId     String
    type       MFAMethod
    status     MFACredentialStatus
    isPrimary  Boolean             @default(false)
    enrolledAt DateTime            @default(now())
    verifiedAt DateTime?
    createdAt  DateTime            @default(now())
    deletedAt  DateTime?

    user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    totpCredential TotpCredential?
    smsCredential  SmsCredential?
    pushCredential PushCredential?
    backupCodes    BackupCode[]
    mfaChallenges  MfaChallenge[]

    @@index([userId])
    @@index([userId, type])
    @@index([userId, status])
    @@index([deletedAt])
}

/// ---------------------------------------------------------------------------
/// TOTP CREDENTIALS
/// ---------------------------------------------------------------------------

model TotpCredential {
    id           String    @id @default(cuid())
    credentialId String    @unique
    secretCipher String    @db.Text
    verifiedAt   DateTime?

    credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

/// ---------------------------------------------------------------------------
/// SMS CREDENTIALS
/// ---------------------------------------------------------------------------

model SmsCredential {
    id           String    @id @default(cuid())
    credentialId String    @unique
    phoneNumber  String
    verifiedAt   DateTime?

    credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

    @@index([phoneNumber])
}

/// ---------------------------------------------------------------------------
/// PUSH CREDENTIALS
/// ---------------------------------------------------------------------------

model PushCredential {
    id           String    @id @default(cuid())
    credentialId String    @unique
    deviceToken  String    @db.Text
    platform     String
    verifiedAt   DateTime?

    credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

/// ---------------------------------------------------------------------------
/// BACKUP CODES
/// ---------------------------------------------------------------------------

model BackupCode {
    id           String    @id @default(cuid())
    credentialId String
    codeHash     String
    used         Boolean   @default(false)
    usedAt       DateTime?
    createdAt    DateTime  @default(now())

    credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

    @@index([credentialId])
    @@index([credentialId, used])
}

/// ---------------------------------------------------------------------------
/// MFA CHALLENGES
/// ---------------------------------------------------------------------------

model MfaChallenge {
    id           String             @id @default(cuid())
    userId       String
    sessionId    String?
    credentialId String
    type         MFAMethod
    status       MFAChallengeStatus @default(pending)
    attemptCount Int                @default(0)
    expiresAt    DateTime
    verifiedAt   DateTime?
    createdAt    DateTime           @default(now())

    user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    session    Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([sessionId])
    @@index([credentialId])
    @@index([status, expiresAt])
}

/// ---------------------------------------------------------------------------
/// VERIFICATION TOKENS
/// ---------------------------------------------------------------------------

model VerificationToken {
    id            String                @id @default(cuid())
    userId        String
    tokenHash     String                @unique
    type          VerificationTokenType
    identifier    String?
    newIdentifier String?
    expiresAt     DateTime
    revokedAt     DateTime?
    createdAt     DateTime              @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([userId, type])
    @@index([identifier, type])
    @@index([expiresAt])
}

/// ---------------------------------------------------------------------------
/// OAUTH TRANSACTIONS
/// ---------------------------------------------------------------------------

model OAuthTransaction {
    id           String   @id @default(cuid())
    provider     String
    state        String   @unique
    nonce        String?
    codeVerifier String?
    redirectURI  String
    redirectTo   String?
    userAgent    String?
    fingerprint  String?
    deviceId     String?
    createdAt    DateTime @default(now())
    expiresAt    DateTime

    device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    @@index([deviceId])
    @@index([provider])
    @@index([expiresAt])
}
