{
  "name": "@aura-stack/express",
  "version": "0.4.1",
  "private": false,
  "type": "module",
  "description": "Authentication integration for Express applications. Provides middleware, route handlers and session verification powered by Aura Auth.",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "pnpm sync:modules && tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:types": "vitest --run --typecheck.only",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist src/generated",
    "clean:cts": "[ -d dist ] && find dist -type f -name \"*.cts\" -delete || true",
    "prepublishOnly": "pnpm sync:modules && pnpm build && pnpm clean:cts",
    "sync:modules": "node ../shared/scripts/modules.js"
  },
  "homepage": "https://aura-stack-auth.vercel.app",
  "bugs": {
    "url": "https://github.com/aura-stack-ts/auth/issues",
    "email": "aurastackjs@gmail.com"
  },
  "license": "MIT",
  "author": "Aura Stack <aurastackjs@gmail.com> | Hernan Alvarado <halvaradop.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aura-stack-ts/auth"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/halvaradop"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "auth",
    "oauth",
    "oauth2",
    "security",
    "session",
    "authentication",
    "authorization",
    "express",
    "expressjs",
    "node",
    "bun",
    "deno",
    "middleware",
    "typescript",
    "javascript",
    "web-api",
    "aura stack",
    "aura-stack",
    "aura-stack-ts",
    "aura stack ts"
  ],
  "dependencies": {
    "@aura-stack/auth": "workspace:*"
  },
  "devDependencies": {
    "@aura-stack/tsconfig": "workspace:*",
    "@aura-stack/tsdown-config": "workspace:*",
    "@types/express": "catalog:express",
    "@types/supertest": "^7.2.0",
    "express": "catalog:express",
    "supertest": "^7.2.2",
    "vitest": "catalog:vitest"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./oauth": {
      "types": "./dist/generated/oauth/index.d.ts",
      "import": "./dist/generated/oauth/index.js",
      "require": "./dist/generated/oauth/index.cjs"
    },
    "./oauth/*": {
      "types": "./dist/generated/oauth/*.d.ts",
      "import": "./dist/generated/oauth/*.js",
      "require": "./dist/generated/oauth/*.cjs"
    },
    "./identity": {
      "types": "./dist/generated/identity/index.d.ts",
      "import": "./dist/generated/identity/index.js",
      "require": "./dist/generated/identity/index.cjs"
    },
    "./identity/*": {
      "types": "./dist/generated/identity/*.d.ts",
      "import": "./dist/generated/identity/*.js",
      "require": "./dist/generated/identity/*.cjs"
    },
    "./crypto": {
      "types": "./dist/generated/exports/crypto.d.ts",
      "import": "./dist/generated/exports/crypto.js",
      "require": "./dist/generated/exports/crypto.cjs"
    },
    "./shared": {
      "types": "./dist/generated/exports/shared.d.ts",
      "import": "./dist/generated/exports/shared.js",
      "require": "./dist/generated/exports/shared.cjs"
    },
    "./cookies": {
      "types": "./dist/exports/cookies.d.ts",
      "import": "./dist/exports/cookies.js",
      "require": "./dist/exports/cookies.cjs"
    },
    "./types": "./dist/@types/index.d.ts"
  },
  "packageManager": "pnpm@12.4.0"
}