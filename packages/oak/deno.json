{
  "name": "@aura-stack/oak",
  "version": "0.1.0",
  "license": "MIT",
  "tasks": {
    "dev": "deno run --watch src/index.ts",
    "test": "deno test --allow-env --allow-net --no-check",
    "test:coverage": "deno test --allow-env --allow-net --no-check --coverage=coverage",
    "test:filter": "deno test --allow-env --allow-net --no-check --filter",
    "test:types": "deno test --allow-env --allow-net --no-check test/types.test-d.ts"
  },
  "imports": {
    "@/": "./src/",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "path-to-regexp": "npm:path-to-regexp@^6.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@oak/oak": "jsr:@oak/oak@^17.2.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./identity": "./src/generated/identity/index.ts",
    "./identity/zod": "./src/generated/identity/zod.ts",
    "./identity/valibot": "./src/generated/identity/valibot.ts",
    "./identity/arktype": "./src/generated/identity/arktype.ts",
    "./identity/typebox": "./src/generated/identity/typebox.ts",
    "./crypto": "./src/generated/exports/crypto.ts",
    "./shared": "./src/generated/exports/shared.ts",
    "./cookies": "./src/generated/exports/cookies.ts",
    "./oauth": "./src/generated/oauth/index.ts",
    "./oauth/atlassian": "./src/generated/oauth/atlassian.ts",
    "./oauth/authentik": "./src/generated/oauth/authentik.ts",
    "./oauth/bitbucket": "./src/generated/oauth/bitbucket.ts",
    "./oauth/click-up": "./src/generated/oauth/click-up.ts",
    "./oauth/coinbase": "./src/generated/oauth/coinbase.ts",
    "./oauth/discord": "./src/generated/oauth/discord.ts",
    "./oauth/dribbble": "./src/generated/oauth/dribbble.ts",
    "./oauth/dropbox": "./src/generated/oauth/dropbox.ts",
    "./oauth/figma": "./src/generated/oauth/figma.ts",
    "./oauth/github": "./src/generated/oauth/github.ts",
    "./oauth/gitlab": "./src/generated/oauth/gitlab.ts",
    "./oauth/google": "./src/generated/oauth/google.ts",
    "./oauth/hubspot": "./src/generated/oauth/hubspot.ts",
    "./oauth/huggingface": "./src/generated/oauth/huggingface.ts",
    "./oauth/mailchimp": "./src/generated/oauth/mailchimp.ts",
    "./oauth/notion": "./src/generated/oauth/notion.ts",
    "./oauth/pinterest": "./src/generated/oauth/pinterest.ts",
    "./oauth/reddit": "./src/generated/oauth/reddit.ts",
    "./oauth/spotify": "./src/generated/oauth/spotify.ts",
    "./oauth/strava": "./src/generated/oauth/strava.ts",
    "./oauth/twitch": "./src/generated/oauth/twitch.ts",
    "./oauth/tiktok": "./src/generated/oauth/tiktok.ts",
    "./oauth/x": "./src/generated/oauth/x.ts",
    "./types": "./src/types/index.ts"
  },
  "publish": {
    "include": ["src/**/*.ts", "src/_core", "src/oauth", "src/identity", "README.md", "CHANGELOG.md"],
    "exclude": ["dist", "node_modules"]
  }
}
