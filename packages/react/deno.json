  "imports": {
    "@/": "./src/",
    "react": "npm:react@^19.2.3",
    "@aura-stack/auth": "npm:@aura-stack/auth@^0.10.1"
  },
  "publish": {
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/_core", "src/oauth", "src/identity", "README.md", "CHANGELOG.md"]
  },
  "exclude": ["dist", "node_modules"]
