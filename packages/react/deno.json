{
  "name": "@aura-stack/react",
  "version": "0.4.1",
  "license": "MIT",
  "tasks": {
    "dev": "deno run --watch src/index.tsx"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./hooks": "./src/hooks.ts",
    "./context": "./src/context.tsx",
    "./server": "./src/server.ts",
