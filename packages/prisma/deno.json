{
  "name": "@aura-stack/prisma",
  "version": "0.1.0",
  "license": "MIT",
  "tasks": {
    "dev": "deno run --watch src/index.ts"
  },
  "imports": {
    "@/": "./src/",
    "pg": "npm:pg@^8.20.0",
    "@prisma/adapter-pg": "npm:@prisma/adapter-pg@7.9.1",
    "@prisma/client": "npm:@prisma/client@7.9.1"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publish": {
    "include": ["src/**/*.ts", "src/generated", "README.md", "CHANGELOG.md"],
    "exclude": ["node_modules", "dist", "!src/generated"]
  }
}
